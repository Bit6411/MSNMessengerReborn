APP_NAME="Ping! Messenger"
# SQLite database file (relative to the project root; created automatically)
SQLITE_DB_PATH=msnmessenger_reborn.db
# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET_48_CHARS_OR_LONGER
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Explicit origins; include the origins you use for the built-in demo UI.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173
MAX_UPLOAD_MB=50
UPLOAD_DIR=uploads
